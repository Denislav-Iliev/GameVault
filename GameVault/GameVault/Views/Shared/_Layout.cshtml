<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - GameVault</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GameVault.styles.css" asp-append-version="true" />
</head>

<body>

    <header class="gv-header">
        <nav class="navbar navbar-expand-lg navbar-dark">
            <div class="container">

                <a class="navbar-brand gv-brand"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">

                    <span class="gv-logo">V</span>

                    <span class="gv-brand-text">
                        GAME<span>VAULT</span>
                    </span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#gameVaultNavigation"
                        aria-controls="gameVaultNavigation"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse"
                     id="gameVaultNavigation">

                    <ul class="navbar-nav ms-auto align-items-lg-center">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Games"
                               asp-action="Index">
                                Games
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Genres"
                               asp-action="Index">
                                Genres
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Reviews"
                               asp-action="Index">
                                Reviews
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link gv-library-link"
                               asp-area=""
                               asp-controller="Library"
                               asp-action="Index">
                                My Library
                            </a>
                        </li>

                    </ul>

                </div>
            </div>
        </nav>
    </header>


    <main class="gv-main">
        <div class="container">
            @RenderBody()
        </div>
    </main>


    <footer class="gv-footer">
        <div class="container">
            <div class="gv-footer-content">

                <div>
                    <span class="gv-footer-brand">GAMEVAULT</span>
                    <span class="gv-footer-copy">
                        © 2026
                    </span>
                </div>

                <div class="gv-footer-tagline">
                    Track. Play. Remember.
                </div>

            </div>
        </div>
    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>