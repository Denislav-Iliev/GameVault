@model IEnumerable<Game>

@{
    ViewData["Title"] = "Games";
}

@if (ViewBag.GenreId != null)
{
    <a asp-controller="Genres"
       asp-action="Index"
       class="gv-details-back gv-back-genres">
        ← BACK TO GENRES
    </a>
}

<div class="gv-page-header">

    <div class="d-flex justify-content-between align-items-end">

        <div>
            <div class="gv-page-eyebrow">EXPLORE THE VAULT</div>

            <h1 class="gv-page-title">
                Games
            </h1>

            <p class="gv-page-description">
                Discover games, explore different genres and find your next adventure.
            </p>
        </div>

        <a asp-controller="Games"
           asp-action="Create"
           class="btn gv-btn-submit">
            + ADD GAME
        </a>

    </div>

</div>


<form asp-controller="Games"
      asp-action="Index"
      method="get"
      class="gv-search-bar">

    <div class="gv-search-input">

        <span class="gv-search-icon">⌕</span>

        <input type="text"
               name="searchTerm"
               placeholder="Search the vault..."
               autocomplete="off" />

    </div>

    <div class="gv-search-divider"></div>

    <select name="genreId"
            class="gv-search-genre">

        <option value="">All Genres</option>

        @foreach (Genre genre in ViewBag.Genres)
        {
            <option value="@genre.Id">
                @genre.Name
            </option>
        }

    </select>

    <button type="submit"
            class="gv-search-button">
        SEARCH
    </button>

    <a asp-controller="Games"
       asp-action="Index"
       class="gv-search-clear">
        CLEAR
    </a>

</form>


<div class="row g-4 mt-3">

    @foreach (Game game in Model)
    {
        <partial name="_GameCardPartial"
                 model="game" />
    }

</div>