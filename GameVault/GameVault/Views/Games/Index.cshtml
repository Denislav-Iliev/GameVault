@model IEnumerable<Game>

@{
    ViewData["Title"] = "Games";
}
@if (ViewBag.GenreId != null)
{
    <a asp-controller="Genres"
       asp-action="Index"
       class="gv-details-back gv-back-genres">
        ← BACK TO GENRES
    </a>
}

<div class="gv-page-header">

    <div class="d-flex justify-content-between align-items-end">

        <div>
            <div class="gv-page-eyebrow">EXPLORE THE VAULT</div>

            <h1 class="gv-page-title">
                Games
            </h1>

            <p class="gv-page-description">
                Discover games, explore different genres and find your next adventure.
            </p>
        </div>

        <a asp-controller="Games"
           asp-action="Create"
           class="btn gv-btn-submit">
            + ADD GAME
        </a>

    </div>

</div>


<div class="row g-4">


    @foreach (Game game in Model)
    {
		<partial name="_GameCardPartial" model="game" />
    }

</div>